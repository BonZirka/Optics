@DeriveOptics
public enum PB_E {
    | Empty
    | Held(PB_P)
}
@DeriveOptics
public class PB_P {
    public PB_P(
        public var a: Int64,
        public var b: Int64) { }
}
private func pbOptPairEq(x: Option<(Int64, Int64)>, y: Option<(Int64, Int64)>): Bool {
    match ((x, y)) {
        case (Some(p), Some(q)) =>
            let (pa, pb) = p
            let (qa, qb) = q
            pa == qa && pb == qb
        case (None, None) => true
        case _ => false
    }
}

extend PB_E {
    operator func ==(other: PB_E): Bool {
        match ((this, other)) {
            case (Empty, Empty) => true
            case (Held(a), Held(b)) => a == b
            case _ => false
        }
    }
}

extend PB_P {
    operator func ==(other: PB_P): Bool {
        this.a == other.a && this.b == other.b
    }
}

// Mutable counter, so the new leaf differs on every call and the optimiser
// cannot hoist the update out of the benchmark loop.
var tick_pb: Int64 = 0

public let v_pb = PB_E.Held(PB_P(0, 0))

// Sink: keeps the compiler from discarding the update as dead code.
public var sink_PrismBlock: Option<PB_E> = None
public var sink_PrismBlockRead: Option<Option<(Int64, Int64)>> = None
@Test
@Configure[baseline: "reconstruct"]
class PrismBlockBench {



    @Bench
    func reconstruct(): Unit {
        tick_pb += 1
        sink_PrismBlock = Some(match (v_pb) {
            case Held(_) => PB_E.Held(PB_P(tick_pb, tick_pb))
            case _ => v_pb
        })
    }
    @Bench
    func optics(): Unit {
        tick_pb += 1
        sink_PrismBlock = @f(v_pb?.Held.{ .a; .b } <- (tick_pb, tick_pb))
    }

    @Bench
    func opticsUnfused(): Unit {
        tick_pb += 1
        sink_PrismBlock = @f[unfuse](v_pb?.Held.{ .a; .b } <- (tick_pb, tick_pb))
    }

    @AfterAll
    func consume(): Unit {
        let _ = sink_PrismBlock
        let _ = sink_PrismBlockRead
    }
}

@Test
class PrismBlockEquivalence {
    @TestCase
    func inlineMatchesReconstruct(): Unit {
        let probe = tick_pb + 1
        let viaInline = @InlineOptics[
            shapes: (PB_P, (a, Int64), (b, Int64)),
                    (PB_E, (Empty, ()), (Held, (p, PB_P))),
            root: PB_E
        ](v_pb?.Held.{ .a; .b } <- (probe, probe))
        let viaReconstruct = Some(match (v_pb) {
            case Held(_) => PB_E.Held(PB_P(probe, probe))
            case _ => v_pb
        }).getOrThrow()
        let viaOptics = @f(v_pb?.Held.{ .a; .b } <- (probe, probe))
        @Assert(viaInline == viaOptics)
        @Assert(viaInline == viaReconstruct)
    }
}

@Test
class PrismBlockReadEquivalence {
    @TestCase
    func readMatchesReconstruct(): Unit {
        tick_pb += 1
        let viaInlineRead = @InlineOptics[
            shapes: (PB_P, (a, Int64), (b, Int64)),
                    (PB_E, (Empty, ()), (Held, (p, PB_P))),
            root: PB_E
        ](v_pb?.Held.{ .a; .b })
        let viaReadReconstruct = match (v_pb) {
            case Held(p) => Some((p.a, p.b))
            case _ => Option<(Int64, Int64)>.None
        }
        let viaOpticsRead = @f(v_pb?.Held.{ .a; .b })
        @Assert(pbOptPairEq(viaInlineRead, viaOpticsRead))
        @Assert(pbOptPairEq(viaInlineRead, viaReadReconstruct))
    }
}
