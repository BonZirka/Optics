// Mutable counter, so the new leaf differs on every call and the optimiser
// cannot hoist the update out of the benchmark loop.
var tick_iso8: Int64 = 0

public let v_iso8 = IS8_S1(IS8_S2(IS8_S3(IS8_S4(IS8_S5(IS8_S6(IS8_S7(IS8_S8(0))))))))

// Sink: keeps the compiler from discarding the update as dead code.
public var sink_Iso8: Option<IS8_S1> = None
public var sink_Iso8Read: Option<Int64> = None
@Test
@Configure[baseline: "reconstruct"]
class Iso8Bench {



    @Bench
    func reconstruct(): Unit {
        tick_iso8 += 1
        sink_Iso8 = Some(IS8_S1(IS8_S2(IS8_S3(IS8_S4(IS8_S5(IS8_S6(IS8_S7(IS8_S8(tick_iso8)))))))))
    }
    @Bench
    func optics(): Unit {
        tick_iso8 += 1
        sink_Iso8 = @f(v_iso8.x.x.x.x.x.x.x.coerce<Int64>() <- tick_iso8)
    }

    @Bench
    func opticsUnfused(): Unit {
        tick_iso8 += 1
        sink_Iso8 = @f[unfuse](v_iso8.x.x.x.x.x.x.x.coerce<Int64>() <- tick_iso8)
    }

    @AfterAll
    func consume(): Unit {
        let _ = sink_Iso8
        let _ = sink_Iso8Read
    }
}

@Test
class Iso8Equivalence {
    @TestCase
    func inlineMatchesReconstruct(): Unit {
        let probe = tick_iso8 + 1
        let viaInline = @InlineOptics[
            shapes: (IS8_S1, (x, IS8_S2)),
                    (IS8_S2, (x, IS8_S3)),
                    (IS8_S3, (x, IS8_S4)),
                    (IS8_S4, (x, IS8_S5)),
                    (IS8_S5, (x, IS8_S6)),
                    (IS8_S6, (x, IS8_S7)),
                    (IS8_S7, (x, IS8_S8)),
                    (IS8_S8, (v, Int64)),
            root: IS8_S1
        ](v_iso8.x.x.x.x.x.x.x.coerce<Int64>() <- probe)
        let viaReconstruct = Some(IS8_S1(IS8_S2(IS8_S3(IS8_S4(IS8_S5(IS8_S6(IS8_S7(IS8_S8(probe))))))))).getOrThrow()
        let viaOptics = @f(v_iso8.x.x.x.x.x.x.x.coerce<Int64>() <- probe)
        @Assert(viaInline == viaOptics)
        @Assert(viaInline == viaReconstruct)
    }
}

@Test
class Iso8ReadEquivalence {
    @TestCase
    func readMatchesReconstruct(): Unit {
        tick_iso8 += 1
        let viaInlineRead = @InlineOptics[
            shapes: (IS8_S1, (x, IS8_S2)),
                    (IS8_S2, (x, IS8_S3)),
                    (IS8_S3, (x, IS8_S4)),
                    (IS8_S4, (x, IS8_S5)),
                    (IS8_S5, (x, IS8_S6)),
                    (IS8_S6, (x, IS8_S7)),
                    (IS8_S7, (x, IS8_S8)),
                    (IS8_S8, (v, Int64)),
            root: IS8_S1
        ](v_iso8.x.x.x.x.x.x.x.coerce<Int64>())
        let viaReadReconstruct = v_iso8.x.x.x.x.x.x.x.v
        let viaOpticsRead = @f(v_iso8.x.x.x.x.x.x.x.coerce<Int64>())
        @Assert(viaInlineRead == viaOpticsRead)
        @Assert(viaInlineRead == viaReadReconstruct)
    }
}
