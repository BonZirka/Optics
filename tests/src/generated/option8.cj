@Test
class Option8Equivalence {
    @TestCase
    func inlineMatchesReconstruct(): Unit {
        let probe = tick_op8 + 1
        let viaInline = @InlineOptics[
            shapes: (OP8_S1, (x, OP8_S2), (y, Int64)),
                    (OP8_S2, (x, OP8_S3), (y, Int64)),
                    (OP8_S3, (x, OP8_S4), (y, Int64)),
                    (OP8_S4, (x, OP8_S5), (y, Int64)),
                    (OP8_S5, (x, OP8_S6), (y, Int64)),
                    (OP8_S6, (x, OP8_S7), (y, Int64)),
                    (OP8_S7, (x, Option<OP8_L>), (y, Int64)),
                    (OP8_L, (a, Int64), (b, Int64)),
            root: OP8_S1
        ](v_op8.x.x.x.x.x.x.x?.a <- probe)
        let viaReconstruct = Some(match (v_op8.x.x.x.x.x.x.x) {
            case Some(leaf) => OP8_S1(OP8_S2(OP8_S3(OP8_S4(OP8_S5(OP8_S6(OP8_S7(OP8_L(probe, leaf.b), v_op8.x.x.x.x.x.x.y), v_op8.x.x.x.x.x.y), v_op8.x.x.x.x.y), v_op8.x.x.x.y), v_op8.x.x.y), v_op8.x.y), v_op8.y)
            case None => v_op8
        }).getOrThrow()
        @Assert(viaInline == viaReconstruct)
    }
}

