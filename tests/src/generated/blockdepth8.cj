@Test
class BlockDepth8Equivalence {
    @TestCase
    func inlineMatchesReconstruct(): Unit {
        let probe = tick_bd8 + 1
        let viaInline = @InlineOptics[
            shapes: (BD8_S1, (x, BD8_S2), (y, Int64)),
                    (BD8_S2, (x, BD8_S3), (y, Int64)),
                    (BD8_S3, (x, BD8_S4), (y, Int64)),
                    (BD8_S4, (x, BD8_S5), (y, Int64)),
                    (BD8_S5, (x, BD8_S6), (y, Int64)),
                    (BD8_S6, (x, BD8_S7), (y, Int64)),
                    (BD8_S7, (x, BD8_S8), (y, Int64)),
                    (BD8_S8, (x, Int64), (y, Int64)),
            root: BD8_S1
        ](v_bd8.x.x.x.x.x.x.x.{ .x; .y } <- (probe, probe))
        let viaReconstruct = Some(BD8_S1(BD8_S2(BD8_S3(BD8_S4(BD8_S5(BD8_S6(BD8_S7(BD8_S8(probe, probe), v_bd8.x.x.x.x.x.x.y), v_bd8.x.x.x.x.x.y), v_bd8.x.x.x.x.y), v_bd8.x.x.x.y), v_bd8.x.x.y), v_bd8.x.y), v_bd8.y)).getOrThrow()
        let viaOptics = @f(v_bd8.x.x.x.x.x.x.x.{ .x; .y } <- (probe, probe))
        @Assert(viaInline == viaOptics)
        @Assert(viaInline == viaReconstruct)
    }
}

