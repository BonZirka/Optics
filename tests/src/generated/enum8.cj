@Test
class Enum8Equivalence {
    @TestCase
    func inlineMatchesReconstruct(): Unit {
        let probe = tick_en8 + 1
        let viaInline = @InlineOptics[
            shapes: (EN8_S1, (x, EN8_S2), (y, Int64)),
                    (EN8_S2, (x, EN8_S3), (y, Int64)),
                    (EN8_S3, (x, EN8_S4), (y, Int64)),
                    (EN8_S4, (x, EN8_S5), (y, Int64)),
                    (EN8_S5, (x, EN8_S6), (y, Int64)),
                    (EN8_S6, (x, EN8_S7), (y, Int64)),
                    (EN8_S7, (x, EN8_E), (y, Int64)),
                    (EN8_E, (Empty, ()), (Held, (v, Int64))),
            root: EN8_S1
        ](v_en8.x.x.x.x.x.x.x?.Held <- probe)
        let viaReconstruct = Some(match (v_en8.x.x.x.x.x.x.x) {
            case Held(_) => EN8_S1(EN8_S2(EN8_S3(EN8_S4(EN8_S5(EN8_S6(EN8_S7(EN8_E.Held(probe), v_en8.x.x.x.x.x.x.y), v_en8.x.x.x.x.x.y), v_en8.x.x.x.x.y), v_en8.x.x.x.y), v_en8.x.x.y), v_en8.x.y), v_en8.y)
            case _ => v_en8
        }).getOrThrow()
        let viaOptics = @f(v_en8.x.x.x.x.x.x.x?.Held <- probe)
        @Assert(viaInline == viaOptics)
        @Assert(viaInline == viaReconstruct)
    }
}

